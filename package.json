{
	"name": "@unicode/unicode-1.1.5",
	"version": "2.1.0",
	"description": "JavaScript-compatible Unicode data. Arrays of code points, arrays of symbols, and regular expressions for Unicode v1.1.5’s categories, scripts, blocks, bidi, and other properties.",
	"homepage": "https://github.com/node-unicode/unicode-1.1.5",
	"main": "index.mjs",
	"keywords": [
		"unicode",
		"unicode-data",
		"code points",
		"symbols",
		"characters",
		"bidi",
		"case-folding",
		"regex",
		"regexp",
		"data"
	],
	"license": "MIT",
	"author": {
		"name": "Mathias Bynens",
		"url": "https://mathiasbynens.be/"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/node-unicode/unicode-1.1.5.git"
	},
	"bugs": "https://github.com/node-unicode/node-unicode-data/issues",
	"engines": {
		"node": ">=12"
	},
	"typesVersions": {
		"*": {
			"Simple_Case_Mapping/*/code-points.mjs": [
				"Simple_Case_Mapping/*/code-points.d.mts"
			],
			"Simple_Case_Mapping/*/symbols.mjs": [
				"Simple_Case_Mapping/*/symbols.d.mts"
			],
			"*/ranges.mjs": [
				"types/ranges.d.mts"
			],
			"*/regex.mjs": [
				"types/regex.d.mts"
			],
			"*/code-points.mjs": [
				"types/code-points.d.mts"
			],
			"*/symbols.mjs": [
				"types/symbols.d.mts"
			]
		}
	}
}
